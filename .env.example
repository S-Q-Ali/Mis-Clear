# Privacy Guardian - environment template (copy to .env, never commit .env)

# --- Backend ---
PG_HOST=127.0.0.1
PG_PORT=8000
PG_DATABASE_PATH=data/database/privacy_guardian.db
PG_LOG_LEVEL=INFO
PG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Local AI (Ollama) ---
PG_OLLAMA_URL=http://127.0.0.1:11434
PG_OLLAMA_REASONING_MODEL=qwen3:8b
PG_OLLAMA_VISION_MODEL=gemma3:4b
PG_OLLAMA_TIMEOUT_SECONDS=120
PG_OLLAMA_RETRIES=2

# --- Colab GPU worker (optional) ---
PG_COLAB_JOB_DISPATCHER_URL=
PG_COLAB_APPROVAL_REQUIRED=true
# Ollama served via a Colab/site tunnel (optional AI worker). Empty = disabled.
PG_COLAB_OLLAMA_URL=

# --- Privacy defaults ---
PG_DEFAULT_SCAN_MODE=local
PG_HYBRID_REQUIRES_EXPLICIT_APPROVAL=true

# --- OSINT tool adapters ---
PG_OSINT_ENABLED=true
PG_OSINT_TIMEOUT_SECONDS=10
PG_OSINT_MANIFEST_EMAIL=tools/site_manifests/email.json
PG_OSINT_MANIFEST_USERNAME=tools/site_manifests/username.json